# ---------------------------------------------------------------------------
# Daily Quiz — environment configuration. Copy to .env.local and fill in.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# MongoDB connection string. Must be a replica set (Atlas, or the provided
# docker-compose single-node replica set) so multi-document transactions work.
MONGODB_URI=
# Database name (the URI may omit it).
MONGODB_DB=quiz_app

# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
# Used to HMAC security metadata and sign one-off tokens.
AUTH_SECRET=

# Public base URL (used in emails and CSRF origin checks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email: "console" logs emails to the server output (dev). "resend" uses the Resend HTTP API.
EMAIL_PROVIDER=console
EMAIL_FROM="Daily Quiz <no-reply@example.com>"
EMAIL_PROVIDER_API_KEY=

# Protects /api/cron/* (send as `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=

# One-time bootstrap of the first SUPER_ADMIN via POST /api/admin/setup.
ADMIN_SETUP_SECRET=

# Optional: behind a trusted reverse proxy, read client IP from X-Forwarded-For.
TRUST_PROXY=false

# Development/E2E only: lets tests move the server clock (ignored in production).
ENABLE_TEST_CLOCK=false

# Seed script (npm run seed). If SEED_ADMIN_PASSWORD is empty a random one is printed once.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_START_OFFSET_DAYS=0
